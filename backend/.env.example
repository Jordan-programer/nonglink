DATABASE_URL=mysql+pymysql://root:@localhost:3306/agrilink
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:19006"]
EE_SERVICE_ACCOUNT_EMAIL=agrilink-ee@your-project.iam.gserviceaccount.com
EE_PRIVATE_KEY_PATH=./secrets/ee-service-account.json
EE_GCP_PROJECT_ID=agrilink-satellite-mvp

# From a PayPal Developer sandbox app: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_MODE=sandbox
# Kz per 1 USD — PayPal doesn't support AOA directly, so order totals (stored
# in Kz) are converted to USD using this rate. Update to a real rate/FX feed
# before going live; this is a placeholder approximation.
PAYPAL_USD_EXCHANGE_RATE=1200

# Google Sign-In: create an OAuth consent screen + 3 client IDs (Web, Android,
# iOS) at https://console.cloud.google.com/apis/credentials — only the client
# secret for the Web client is needed here (Android/iOS are public clients).
# Leave the ones you haven't created yet blank.
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com

# Facebook Login: create an app at https://developers.facebook.com/apps,
# add the "Facebook Login" product, and set these from Settings > Basic.
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# SMTP for sending email-verification links. Works with any SMTP provider
# (Gmail with an App Password, SendGrid/Mailgun SMTP relay, etc). If left
# blank, verification emails are logged to the console instead of sent —
# useful for local dev without real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@agrilink.ao
SMTP_USE_TLS=true
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48
# Used to build the verification link sent by email — must match wherever
# the web frontend is actually served from.
FRONTEND_BASE_URL=http://localhost:5173
