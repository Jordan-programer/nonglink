# Override the Vite dev-server proxy target if 127.0.0.1 can't reach your
# backend (e.g. a stuck OS-level socket) — point it at your LAN IP instead.
BACKEND_URL=http://127.0.0.1:8000

# Google Sign-In: the Web client ID from
# https://console.cloud.google.com/apis/credentials (client IDs are public,
# safe to expose in the frontend bundle — the secret stays backend-only).
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Facebook Login: the App ID from https://developers.facebook.com/apps
# (Settings > Basic). Also public/safe to expose client-side.
VITE_FACEBOOK_APP_ID=your-facebook-app-id
