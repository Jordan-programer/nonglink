{
  "expo": {
    "name": "AgriLink",
    "slug": "mobile",
    "version": "1.0.0",
    "scheme": "agrilink",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agrilink.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.agrilink.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O AgriLink precisa de acesso às tuas fotos para adicionares imagens dos teus produtos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O AgriLink usa a tua localização para te ajudar a encontrar a tua lavra no mapa."
        }
      ],
      "expo-font",
      "react-native-paypal-web-payments",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00dd9646-1369-425d-b945-d60127f9f724"
      }
    }
  }
}
