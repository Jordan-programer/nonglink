# Google Sign-In: the Android/iOS OAuth client IDs from
# https://console.cloud.google.com/apis/credentials (public client IDs, safe
# to bundle into the app — no secret involved for these client types).
# When creating the Android client you'll need:
#   - package name: com.agrilink.app
#   - SHA-1 signing certificate fingerprint: get it from `eas credentials -p android`
#   - "Enable Custom URI scheme" turned on, since the redirect uses agrilink://
#     (Google blocks custom-scheme redirects by default to prevent app impersonation)
# For iOS the client just needs the bundle ID: com.agrilink.app
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com

# Facebook Login: the App ID from https://developers.facebook.com/apps
# (Settings > Basic). Also public/safe to bundle client-side. Under the
# Facebook Login product's settings, add "agrilink://" as a Valid OAuth
# Redirect URI (and enable "Client OAuth Login" + "Web OAuth Login").
EXPO_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
